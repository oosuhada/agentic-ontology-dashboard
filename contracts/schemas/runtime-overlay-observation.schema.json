{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/runtime-overlay-observation.schema.json",
  "title": "Runtime Overlay Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "schema_version",
    "run_id",
    "sequence",
    "asset_id",
    "equipment_id",
    "observed_at",
    "generated_at",
    "measurements",
    "generator_version",
    "asset_type",
    "site_id",
    "cell_id",
    "source_kind",
    "observation_id",
    "observation_sha256",
    "observed_at_source",
    "branch_kind",
    "overlay",
    "record_kind",
    "quality",
    "base_dataset_version",
    "base_source_sha256",
    "simulation_session_id",
    "overlay_branch_id",
    "maintenance_event_id",
    "maintenance_action_id",
    "state_version",
    "history_segment_id",
    "air_temperature_k",
    "process_temperature_k",
    "rotational_speed_rpm",
    "torque_nm",
    "tool_wear_min",
    "is_operating",
    "operating_state",
    "product_type"
  ],
  "properties": {
    "contract_version": {"const": "runtime-overlay-observation-v1"},
    "schema_version": {"const": "2"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "sequence": {"type": "integer", "minimum": 1},
    "asset_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "equipment_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "observed_at": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "measurements": {"$ref": "#/$defs/cncMeasurements"},
    "generator_version": {"type": "string", "minLength": 1, "maxLength": 240},
    "asset_type": {"const": "cnc"},
    "site_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "cell_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "source_kind": {"const": "maintenance_replay_overlay"},
    "observation_id": {"type": "string", "pattern": "^obs-[a-f0-9]{32}$"},
    "observation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_at_source": {"enum": ["source", "server", "received"]},
    "branch_kind": {"const": "overlay"},
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay_id",
        "parent_branch",
        "maintenance_event_id",
        "state_patch_reference",
        "simulation_session_id",
        "history_segment_id",
        "state_version"
      ],
      "properties": {
        "overlay_id": {"type": "string", "minLength": 1, "maxLength": 240},
        "parent_branch": {"const": "canonical"},
        "maintenance_event_id": {"type": "string", "minLength": 1, "maxLength": 240},
        "state_patch_reference": {"type": "string", "minLength": 1, "maxLength": 240},
        "simulation_session_id": {"type": "string", "minLength": 1, "maxLength": 240},
        "history_segment_id": {"type": "string", "minLength": 1, "maxLength": 240},
        "state_version": {"type": "integer", "minimum": 1}
      }
    },
    "record_kind": {"const": "full_observation"},
    "quality": {"enum": ["good", "uncertain", "bad"]},
    "base_dataset_version": {"type": "string", "minLength": 1, "maxLength": 240},
    "base_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "simulation_session_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "overlay_branch_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "maintenance_event_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "maintenance_action_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "state_version": {"type": "integer", "minimum": 1},
    "history_segment_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "air_temperature_k": {"type": "number", "exclusiveMinimum": 0},
    "process_temperature_k": {"type": "number", "exclusiveMinimum": 0},
    "rotational_speed_rpm": {"type": "number", "minimum": 0},
    "torque_nm": {"type": "number", "minimum": 0},
    "tool_wear_min": {"type": "number", "minimum": 0},
    "is_operating": {"type": "integer", "enum": [0, 1]},
    "operating_state": {"type": "string", "minLength": 1, "maxLength": 64},
    "product_type": {"type": "string", "minLength": 1, "maxLength": 64}
  },
  "$defs": {
    "cncMeasurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "air_temperature_k",
        "process_temperature_k",
        "rotational_speed_rpm",
        "torque_nm",
        "tool_wear_min",
        "is_operating",
        "operating_state",
        "product_type"
      ],
      "properties": {
        "air_temperature_k": {"type": "number", "exclusiveMinimum": 0},
        "process_temperature_k": {"type": "number", "exclusiveMinimum": 0},
        "rotational_speed_rpm": {"type": "number", "minimum": 0},
        "torque_nm": {"type": "number", "minimum": 0},
        "tool_wear_min": {"type": "number", "minimum": 0},
        "is_operating": {"type": "integer", "enum": [0, 1]},
        "operating_state": {"type": "string", "minLength": 1, "maxLength": 64},
        "product_type": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }
  }
}
