# Current Predictive Maintenance MVP
APP_ENV=development
APP_HOST=127.0.0.1
API_PORT=8100
WEB_PORT=3100

# SQLite is supported for local Gold Fixture fallback. Canonical V3.1 runtime requires PostgreSQL.
ONTOLOGY_DASHBOARD_DB=./data/local/ontology_dashboard.db
ONTOLOGY_DASHBOARD_DATABASE_URL=
ONTOLOGY_DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:3100
ONTOLOGY_DASHBOARD_ALLOW_PRODUCTION_SQLITE=0
ONTOLOGY_DASHBOARD_RUN_STARTUP_MIGRATIONS=0
VITE_API_BASE_URL=http://127.0.0.1:8100

# Development/demo identity bootstrap. This is forbidden when APP_ENV=production.
SEED_DEMO_ACCOUNTS=1

# Deterministic reports are the default. Credentials are optional.
LLM_PROVIDER=deterministic
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20

# Canonical V3.1 PostgreSQL runtime
POSTGRES_DB=ontology_dashboard
POSTGRES_USER=ontology
POSTGRES_PASSWORD=ontology-local-only
POSTGRES_PORT=5432

# Optional shared rate limiter
REDIS_PASSWORD=ontology-local-only
REDIS_PORT=6379
ONTOLOGY_DASHBOARD_REDIS_URL=
ONTOLOGY_DASHBOARD_REDIS_TLS_REQUIRED=1
ONTOLOGY_DASHBOARD_REDIS_POOL_MAX=20

# Local UX
OPEN_BROWSER=1
