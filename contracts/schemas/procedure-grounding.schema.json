{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/procedure-grounding.schema.json",
  "title": "Procedure Grounding",
  "description": "SOP retrieval and procedure-grounding contract. SOP fixtures provide reference guidance and sensor-based inspection judgment criteria for UI and agent handoff drafts; they are not Product Evidence, mutation commands, repair instructions, or proof of prevented failure.",
  "type": "object",
  "required": [
    "schema_version",
    "sop_id",
    "title",
    "version",
    "source_kind",
    "maturity",
    "owner_domain",
    "asset_types",
    "component_ids",
    "failure_modes",
    "factor_keys",
    "applicability",
    "safety_level",
    "requires_human_approval",
    "effective_from",
    "source_uri",
    "document_hash",
    "standard_alignment",
    "sensor_judgment",
    "guidance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "procedure-grounding-v1.1"},
    "sop_id": {"type": "string"},
    "title": {"type": "string"},
    "version": {"type": "string"},
    "source_kind": {"enum": ["industry_standard_reference", "site_sop", "demo_sop_fixture"]},
    "maturity": {"enum": ["fixture", "draft", "approved", "retired"]},
    "owner_domain": {"enum": ["maintenance", "operations", "safety", "quality"]},
    "asset_types": {
      "type": "array",
      "description": "Asset types this SOP can guide. Multiple values are allowed only for intentionally shared procedures; each declared asset type must be covered by matching fixture or contract tests.",
      "items": {"type": "string"}
    },
    "component_ids": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "factor_keys": {"type": "array", "items": {"type": "string"}},
    "applicability": {
      "type": "object",
      "required": ["risk_grades", "criticality", "production_impact"],
      "additionalProperties": false,
      "properties": {
        "risk_grades": {"type": "array", "items": {"type": "string"}},
        "criticality": {"type": "array", "items": {"enum": ["low", "medium", "high"]}},
        "production_impact": {"type": "array", "items": {"enum": ["none", "low", "medium", "high"]}}
      }
    },
    "safety_level": {"enum": ["none", "caution", "permit_required", "shutdown_controlled"]},
    "requires_human_approval": {"type": "boolean"},
    "effective_from": {"type": "string"},
    "source_uri": {"type": "string"},
    "document_hash": {"type": "string"},
    "standard_alignment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["standard", "alignment_scope"],
        "additionalProperties": false,
        "properties": {
          "standard": {"enum": ["ISO_17359", "ISO_14224", "ISA_95", "IEC_62264", "OPA"]},
          "alignment_scope": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "sensor_judgment": {
      "type": "object",
      "description": "SOP-owned sensor criteria that can support an Inspection Result outcome. These criteria do not prove an actual failure outcome and do not create MaintenanceEvent or WorkOrder side effects by themselves.",
      "required": [
        "judgment_scope",
        "allowed_outcomes",
        "criteria",
        "inspection_result_mapping",
        "claim_boundaries"
      ],
      "additionalProperties": false,
      "properties": {
        "judgment_scope": {"enum": ["inspection_result", "maintenance_need_screening"]},
        "allowed_outcomes": {
          "type": "array",
          "items": {
            "enum": [
              "maintenance_recommended",
              "monitor_only",
              "data_quality_hold",
              "escalate_to_authorized_shutdown_review"
            ]
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "criterion_id",
              "factor_key",
              "operator",
              "threshold",
              "outcome_if_met",
              "evidence_role",
              "human_check_required"
            ],
            "additionalProperties": false,
            "properties": {
              "criterion_id": {"type": "string"},
              "factor_key": {"type": "string"},
              "operator": {"enum": [">=", ">", "<=", "<", "between", "outside_range", "observed"]},
              "threshold": {
                "type": "object",
                "required": ["kind", "unit"],
                "additionalProperties": false,
                "properties": {
                  "kind": {"enum": ["absolute", "product_type_map", "qualitative"]},
                  "value": {"type": ["number", "null"]},
                  "values": {
                    "type": ["object", "null"],
                    "additionalProperties": {"type": "number"}
                  },
                  "unit": {"type": "string"}
                }
              },
              "outcome_if_met": {
                "enum": [
                  "maintenance_recommended",
                  "monitor_only",
                  "data_quality_hold",
                  "escalate_to_authorized_shutdown_review"
                ]
              },
              "evidence_role": {"enum": ["supporting_sensor", "primary_sensor", "corroborating_sensor"]},
              "human_check_required": {"type": "boolean"},
              "notes": {"type": "string"}
            }
          }
        },
        "inspection_result_mapping": {
          "type": "object",
          "required": [
            "records_operational_fact",
            "does_not_create_maintenance_event",
            "manual_recommendation_requires_manager_acceptance"
          ],
          "additionalProperties": false,
          "properties": {
            "records_operational_fact": {"type": "boolean"},
            "does_not_create_maintenance_event": {"type": "boolean"},
            "manual_recommendation_requires_manager_acceptance": {"type": "boolean"}
          }
        },
        "claim_boundaries": {
          "type": "object",
          "required": ["allowed_claims", "forbidden_claims"],
          "additionalProperties": false,
          "properties": {
            "allowed_claims": {"type": "array", "items": {"type": "string"}},
            "forbidden_claims": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "guidance": {
      "type": "object",
      "required": [
        "reference_location_label",
        "suggested_check_method",
        "checklist_draft",
        "maintenance_review_prerequisites",
        "disclaimer",
        "allowed_ui_claims",
        "forbidden_ui_claims"
      ],
      "additionalProperties": false,
      "properties": {
        "reference_location_label": {"type": "string"},
        "suggested_check_method": {"type": "string"},
        "checklist_draft": {"type": "array", "items": {"type": "string"}},
        "maintenance_review_prerequisites": {
          "type": "object",
          "description": "SOP-based prerequisites that a human must verify before making a maintenance decision. This is not timing or cost guidance, a Recommendation, approval, or WorkOrder command.",
          "required": ["label", "review_conditions", "required_measurements", "human_review_questions", "decision_boundary"],
          "additionalProperties": false,
          "properties": {
            "label": {"type": "string"},
            "review_conditions": {"type": "array", "items": {"type": "string"}},
            "required_measurements": {"type": "array", "items": {"type": "string"}},
            "human_review_questions": {"type": "array", "items": {"type": "string"}},
            "decision_boundary": {"type": "string"}
          }
        },
        "disclaimer": {"type": "string"},
        "allowed_ui_claims": {"type": "array", "items": {"type": "string"}},
        "forbidden_ui_claims": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
