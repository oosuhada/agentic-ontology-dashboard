{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/generator-extraction-fragment-manifest.schema.json",
  "title": "Generator Extraction Fragment Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fragment_schema_version",
    "batch_id",
    "run_id",
    "source_identity",
    "source_uri",
    "source_start_offset",
    "source_end_offset",
    "source_start_line",
    "source_end_line",
    "mapping_id",
    "mapping_version",
    "mapping_sha256",
    "record_count",
    "observation_count",
    "rejected_count",
    "files",
    "created_at"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fragment_schema_version": {
      "type": "string",
      "enum": [
        "generator-extraction-fragment-v1"
      ]
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_uri": {
      "type": "string",
      "minLength": 1
    },
    "source_start_offset": {
      "type": "integer",
      "minimum": 0
    },
    "source_end_offset": {
      "type": "integer",
      "minimum": 0
    },
    "source_start_line": {
      "type": "integer",
      "minimum": 0
    },
    "source_end_line": {
      "type": "integer",
      "minimum": 0
    },
    "mapping_id": {
      "type": "string",
      "minLength": 1
    },
    "mapping_version": {
      "type": "string",
      "minLength": 1
    },
    "mapping_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "observation_count": {
      "type": "integer",
      "minimum": 0
    },
    "rejected_count": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "observations",
              "provenance",
              "rejected"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
