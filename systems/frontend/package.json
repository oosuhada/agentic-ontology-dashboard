{
  "name": "ontology-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3100 --strictPort",
    "build": "tsc -b && vite build && node scripts/check-initial-bundle.mjs",
    "build:pages": "GITHUB_PAGES=1 VITE_PUBLIC_STORY=1 tsc -b && GITHUB_PAGES=1 VITE_PUBLIC_STORY=1 vite build && node scripts/prepare-github-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3100 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:operations": "playwright test e2e/operations-frontend-convergence.spec.ts --project=chromium",
    "test:e2e:overhaul": "playwright test e2e/workbench-final-overhaul.spec.ts",
    "capture:team-share": "CAPTURE_TEAM_SHARE=1 playwright test e2e/team-share-captures.spec.ts --project=chromium",
    "capture:team-share-story": "CAPTURE_TEAM_SHARE=1 playwright test e2e/team-share-story.spec.ts e2e/team-share-responsive.spec.ts --project=chromium",
    "capture:team-share-adaptive": "CAPTURE_TEAM_SHARE_ADAPTIVE=1 playwright test e2e/team-share-adaptive-captures.spec.ts e2e/dashboard-dark-mode-regression.spec.ts e2e/team-share-adaptive-story.spec.ts --project=chromium",
    "check:docs": "python3 ../../scripts/check_docs_structure.py",
    "check:backend-core": "cd ../.. && PYTHONPATH=systems/backend:ml/src .venv/bin/pytest -q tests/test_auth_rbac.py tests/test_dashboard_stages20_24.py",
    "verify:team-share": "npm run check:docs && npm run check:backend-core && npm run lint && npm run test && npm run build && playwright test e2e/team-share-story.spec.ts e2e/team-share-responsive.spec.ts --project=chromium",
    "verify:team-share-adaptive": "npm run lint && npm run test && npm run build && playwright test e2e/team-share-adaptive-story.spec.ts e2e/dashboard-dark-mode-regression.spec.ts --project=chromium",
    "clean:local": "python3 ../../scripts/clean_local_artifacts.py",
    "test:visual:overhaul": "python3 ../../scripts/check_palantir_overhaul_visuals.py --candidate-root test-results/palantir-overhaul-candidate --require-candidate",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@visx/curve": "4.0.1-alpha.0",
    "@visx/event": "4.0.1-alpha.0",
    "@visx/responsive": "4.0.1-alpha.0",
    "@visx/scale": "4.0.1-alpha.0",
    "@visx/shape": "4.0.1-alpha.0",
    "@xyflow/react": "^12.11.2",
    "animejs": "^4.5.0",
    "d3-array": "^3.2.4",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.28.0",
    "motion": "^13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-grid-layout": "^2.2.4"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-alpha.3",
    "@emnapi/runtime": "^2.0.0-alpha.3",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
