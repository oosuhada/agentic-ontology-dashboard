{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/dataset-bundle-manifest.schema.json",
  "title": "Ontology Dashboard Dataset Bundle Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "manifest_id",
    "organization_id",
    "project_id",
    "workspace_id",
    "adapter_code",
    "dataset_name",
    "dataset_version",
    "schema_version",
    "bundle_checksum_sha256",
    "generation",
    "source_contract",
    "files",
    "created_at"
  ],
  "properties": {
    "manifest_version": { "const": "2.0" },
    "manifest_id": { "$ref": "#/$defs/identity" },
    "organization_id": { "$ref": "#/$defs/identity" },
    "project_id": { "$ref": "#/$defs/identity" },
    "workspace_id": { "$ref": "#/$defs/identity" },
    "adapter_code": { "$ref": "#/$defs/identity" },
    "dataset_name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "dataset_version": { "type": "string", "minLength": 1, "maxLength": 160 },
    "schema_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "bundle_checksum_sha256": { "$ref": "#/$defs/sha256" },
    "generation": { "$ref": "#/$defs/generation" },
    "source_contract": { "$ref": "#/$defs/sourceContract" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/runtimeFile" }
    },
    "governance_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/governanceArtifact" },
      "default": []
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_version",
        "seed",
        "period_start",
        "period_end",
        "observation_interval_minutes"
      ],
      "properties": {
        "generator_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "seed": { "type": "integer" },
        "period_start": { "type": "string", "format": "date-time" },
        "period_end": { "type": "string", "format": "date-time" },
        "observation_interval_minutes": { "type": "integer", "minimum": 1 },
        "rate_profile": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compressor_and_cnc_independent",
        "topology_relation_is_not_causal_truth",
        "upstream_features_in_source",
        "synthetic_effect_columns_in_source",
        "prediction_outputs_in_source",
        "evaluation_truth_separate"
      ],
      "properties": {
        "compressor_and_cnc_independent": { "type": "boolean" },
        "topology_relation_is_not_causal_truth": { "type": "boolean" },
        "upstream_features_in_source": { "type": "boolean" },
        "synthetic_effect_columns_in_source": { "type": "boolean" },
        "prediction_outputs_in_source": { "type": "boolean" },
        "evaluation_truth_separate": { "const": true },
        "cnc_ai4i_physical_relations": { "enum": [true, null] },
        "failure_modes_satisfy_sensor_conditions": { "enum": [true, null] },
        "asset_variability_policy": {
          "enum": ["small_offsets_plus_time_varying_physical_process", null]
        }
      }
    },
    "governanceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "uri", "checksum_sha256", "media_type", "summary"],
      "properties": {
        "role": { "const": "package_validation" },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "not": { "pattern": "(^|[\\/])(evaluation_truth|hidden_truth)([\\/]|$)" }
        },
        "checksum_sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "const": "application/json" },
        "summary": { "type": "object" }
      }
    },
    "fileSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "required_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "default": []
        },
        "primary_key": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "default": []
        },
        "timestamp_field": { "type": ["string", "null"], "maxLength": 256 },
        "timezone": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "runtimeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "uri",
        "format",
        "media_type",
        "checksum_sha256",
        "size_bytes",
        "schema"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,127}$",
          "not": {
            "enum": [
              "evaluation_truth",
              "failure_schedule",
              "compressor_failure_truth",
              "cnc_failure_truth"
            ]
          }
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "not": { "pattern": "(^|[\\/])evaluation_truth([\\/]|$)" }
        },
        "format": { "type": "string", "enum": ["csv", "json", "jsonl", "parquet"] },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "checksum_sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "schema": { "$ref": "#/$defs/fileSchema" }
      }
    }
  }
}
