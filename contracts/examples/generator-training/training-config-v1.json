{
  "training_config_version": "training-config-v1",
  "description": "Standard Generator Training Configuration with 70/15/15 asset-time split and hyperparameter defaults",
  "split_strategy": "asset_time_split",
  "split_ratio": {
    "train": 0.70,
    "validation": 0.15,
    "test": 0.15
  },
  "random_seed": 42,
  "hyperparameters": {
    "lightgbm": {
      "n_estimators": 100,
      "learning_rate": 0.05,
      "max_depth": 6,
      "num_leaves": 31
    },
    "xgboost": {
      "n_estimators": 100,
      "learning_rate": 0.05,
      "max_depth": 6
    },
    "random_forest": {
      "n_estimators": 100,
      "max_depth": 10,
      "min_samples_split": 2
    }
  },
  "metrics": [
    "f1",
    "accuracy",
    "precision",
    "recall",
    "roc_auc"
  ],
  "primary_metric": "f1"
}
