{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/generator-training-config.schema.json",
  "title": "Generator Training Configuration Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "training_config_version",
    "split_strategy",
    "split_ratio",
    "random_seed",
    "hyperparameters",
    "metrics",
    "primary_metric"
  ],
  "properties": {
    "training_config_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
    },
    "description": {
      "type": "string"
    },
    "split_strategy": {
      "type": "string",
      "enum": ["asset_time_split"]
    },
    "split_ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "validation": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "test": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "random_seed": {
      "type": "integer"
    },
    "hyperparameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "primary_metric": {
      "type": "string"
    }
  }
}
