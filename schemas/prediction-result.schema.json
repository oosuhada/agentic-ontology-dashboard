{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/prediction-result.schema.json",
  "title": "Ontology Dashboard Prediction Result Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "prediction_id",
    "organization_id",
    "project_id",
    "workspace_id",
    "subject",
    "prediction",
    "evidence",
    "model",
    "created_at"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "prediction_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "organization_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_run_id": { "type": ["string", "null"], "maxLength": 128 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id"],
      "properties": {
        "object_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "object_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "status", "score", "confidence"],
      "properties": {
        "task": {
          "type": "string",
          "enum": ["classification", "regression", "ranking", "anomaly_detection", "forecast"]
        },
        "status": {
          "type": "string",
          "enum": ["normal", "attention", "warning", "critical", "data_quality_hold"]
        },
        "label": { "type": ["string", "null"], "maxLength": 256 },
        "score": { "type": ["number", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "horizon": { "type": ["string", "null"], "maxLength": 128 },
        "value": { "type": ["number", "string", "boolean", "null"] },
        "unit": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind", "label", "value", "source"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "kind": { "type": "string", "enum": ["feature", "rule", "observation", "history", "peer", "artifact"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 256 },
          "value": {},
          "unit": { "type": ["string", "null"], "maxLength": 64 },
          "contribution": { "type": ["number", "null"] },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["system", "reference"],
            "properties": {
              "system": { "type": "string", "minLength": 1, "maxLength": 128 },
              "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
              "checksum": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
            }
          }
        }
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_type", "label", "requires_approval"],
        "properties": {
          "action_type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "label": { "type": "string", "minLength": 1, "maxLength": 256 },
          "reason": { "type": ["string", "null"], "maxLength": 2000 },
          "requires_approval": { "type": "boolean" },
          "parameters": { "type": "object" }
        }
      },
      "default": []
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_name", "model_version", "dataset_version"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dataset_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policy_version": { "type": ["string", "null"], "maxLength": 128 },
        "code_version": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["pass", "warning", "hold"] },
        "issues": {
          "type": "array",
          "items": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
