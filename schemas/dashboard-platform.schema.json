{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/dashboard-platform.schema.json",
  "title": "Ontology Dashboard Platform Contracts",
  "$defs": {
    "parameterDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "value_type", "scope", "default_value", "options", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "value_type": { "enum": ["string", "number", "integer", "boolean", "datetime", "object", "array"] },
        "scope": { "enum": ["dashboard", "tab", "board"] },
        "default_value": {},
        "options": { "type": "array" },
        "description": { "type": ["string", "null"] }
      }
    },
    "boardLayout": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["x", "y", "w", "h", "min_w", "min_h", "max_w", "max_h"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 11 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1, "maximum": 12 },
        "h": { "type": "integer", "minimum": 1, "maximum": 12 },
        "min_w": { "type": ["integer", "null"], "minimum": 1, "maximum": 12 },
        "min_h": { "type": ["integer", "null"], "minimum": 1, "maximum": 12 },
        "max_w": { "type": ["integer", "null"], "minimum": 1, "maximum": 12 },
        "max_h": { "type": ["integer", "null"], "minimum": 1, "maximum": 12 }
      }
    },
    "boardSource": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "analysis_id", "analysis_node_id", "version_policy", "version"],
      "properties": {
        "kind": { "const": "analysis_board" },
        "analysis_id": { "type": "string", "minLength": 1 },
        "analysis_node_id": { "type": "string", "minLength": 1 },
        "version_policy": { "enum": ["pinned", "latest_published"] },
        "version": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definition_id", "title", "width", "order", "layout", "source", "hidden", "mandatory", "custom", "bindings", "settings"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "definition_id": { "type": "string", "minLength": 2 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "width": { "type": "integer", "minimum": 1, "maximum": 12 },
        "order": { "type": "integer", "minimum": 0 },
        "layout": { "$ref": "#/$defs/boardLayout" },
        "source": { "$ref": "#/$defs/boardSource" },
        "hidden": { "type": "boolean" },
        "mandatory": { "type": "boolean" },
        "custom": { "type": "boolean" },
        "bindings": { "type": "object" },
        "settings": { "type": "object" }
      }
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order", "hidden", "custom", "parameter_ids", "boards"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "order": { "type": "integer", "minimum": 0 },
        "hidden": { "type": "boolean" },
        "custom": { "type": "boolean" },
        "parameter_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "boards": { "type": "array", "items": { "$ref": "#/$defs/board" } }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_board_id", "target_board_id", "parameter_ids"],
      "properties": {
        "source_board_id": { "type": "string", "minLength": 1 },
        "target_board_id": { "type": "string", "minLength": 1 },
        "parameter_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
      }
    },
    "resolvedDashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dashboard_id", "template_id", "template_version", "preference_revision",
        "preference_template_version", "workspace_id", "role_code", "display_name",
        "tabs", "active_tab_id", "parameter_state", "parameter_definitions",
        "dependency_graph", "merge_notices"
      ],
      "properties": {
        "dashboard_id": { "type": "string", "minLength": 1 },
        "template_id": { "type": "string", "minLength": 1 },
        "template_version": { "type": "integer", "minimum": 1 },
        "preference_revision": { "type": "integer", "minimum": 0 },
        "preference_template_version": { "type": ["integer", "null"], "minimum": 1 },
        "workspace_id": { "type": "string", "minLength": 1 },
        "role_code": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "tabs": { "type": "array", "items": { "$ref": "#/$defs/tab" }, "minItems": 1 },
        "active_tab_id": { "type": "string", "minLength": 1 },
        "parameter_state": { "type": "object" },
        "parameter_definitions": { "type": "array", "items": { "$ref": "#/$defs/parameterDefinition" } },
        "dependency_graph": { "type": "array", "items": { "$ref": "#/$defs/dependencyEdge" } },
        "merge_notices": { "type": "array", "items": { "type": "string" } }
      }
    },
    "preferenceSave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "base_revision", "active_tab_id", "tabs", "parameter_state"],
      "properties": {
        "workspace_id": { "type": "string", "minLength": 1 },
        "base_revision": { "type": "integer", "minimum": 0 },
        "active_tab_id": { "type": "string", "minLength": 1 },
        "tabs": { "type": "array", "items": { "$ref": "#/$defs/tab" }, "minItems": 1 },
        "parameter_state": { "type": "object" }
      }
    },
    "sharePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "active_tab_id", "parameter_state", "owner_user_id", "created_at", "expires_at"],
      "properties": {
        "workspace_id": { "type": "string", "minLength": 1 },
        "active_tab_id": { "type": "string", "minLength": 1 },
        "parameter_state": { "type": "object" },
        "owner_user_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/resolvedDashboard" },
    { "$ref": "#/$defs/preferenceSave" },
    { "$ref": "#/$defs/sharePayload" }
  ]
}
