# Application
APP_ENV=development
APP_HOST=127.0.0.1
API_PORT=8100
WEB_PORT=3100
FACTORY_SIGNAL_DB=./data/local/factory_signal_board.db
VITE_API_BASE_URL=http://127.0.0.1:8100
OPEN_BROWSER=1

# Development/demo identity bootstrap. Demo accounts are always forbidden when
# APP_ENV=production, even if this flag is accidentally enabled.
SEED_DEMO_ACCOUNTS=1

# Model and policy
MODEL_ARTIFACT_PATH=./ml/artifacts/model.joblib
TRAINED_MODEL_POLICY_PATH=./ml/config/trained_model_policy.json
THRESHOLD_POLICY_PATH=./ml/config/threshold_policy.json
REPORT_MODE=deterministic

# Optional OpenAI-compatible LLM provider.
# With empty credentials, reports and layouts use deterministic fallback.
LLM_PROVIDER=deterministic
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
OPENAI_API_KEY=

# Vertex AI (recommended): authenticate with ADC or a service account. Do not put a
# Vertex credential JSON or a Google API key in this file.
# LLM_PROVIDER=vertex-ai
# LLM_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# Optional provider-specific keys retained for future adapters
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Optional project 3 context adapter: fixture | project3_http
MAINTENANCE_CONTEXT_PROVIDER=fixture
PROJECT3_API_URL=

# Future Neo4j direct adapter fields
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
