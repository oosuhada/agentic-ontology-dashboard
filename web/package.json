{
  "name": "ontology-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3100 --strictPort",
    "build": "tsc -b && vite build && node scripts/check-initial-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3100 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/mvp-frontend-convergence.spec.ts --project=chromium",
    "verify": "npm run lint && npm run test && npm run build && npm run test:e2e",
    "capture:mvp": "node scripts/capture-mvp-evidence.mjs",
    "clean:local": "python3 ../scripts/clean_local_artifacts.py",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "lucide-react": "^1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
