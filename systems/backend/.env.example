# Backend System Environment Configuration Example
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Runtime asset root containing contracts/schemas/, prompts/ and data/fixtures/. Docker
# images pin this to /app so non-editable site-packages installs do not derive
# the project root from ontology_dashboard.__file__.
ONTOLOGY_DASHBOARD_PROJECT_ROOT=/app

# Versioned Model Artifact provider. Never point this at a sibling generator
# relative path such as ../generator/.... Local path, mounted volume, object
# storage or an artifact-registry adapter may be injected per deployment.
MODEL_ARTIFACT_URI=/var/lib/ontology-dashboard/model-artifacts

# local/demo/test allow the heuristic fallback by default when this variable is
# omitted. development/dev/deploy/staging/production fail closed without a
# Model Artifact unless fallback is explicitly enabled for a specific run.
ONTOLOGY_DASHBOARD_ALLOW_HEURISTIC_MODEL_FALLBACK=0

# Writable, immutable Runtime Prediction snapshot root. The live-ingestor writes
# content-addressed JSONL snapshots here and Generator must mount the same
# absolute container path read-only. Do not point this at GEN_DATA_RUNTIME_OUTPUT_ROOT.
ONTOLOGY_DASHBOARD_RUNTIME_PIPELINE_INPUT_ROOT=/runtime-pipeline-input

# Generator-owned HTTP enqueue boundary used by the live-ingestor. Configure it
# only when the persistent Generator Runtime API is deployed.
ONTOLOGY_DASHBOARD_GENERATOR_RUNTIME_ENQUEUE_URL=
