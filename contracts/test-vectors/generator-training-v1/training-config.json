    },
    "xgboost": {
      "n_estimators": 50,
      "learning_rate": 0.1
    },
    "random_forest": {
      "n_estimators": 50
    }
  },
  "metrics": [
    "f1",
    "accuracy",
    "precision",
    "recall",
    "roc_auc"
  ],
  "primary_metric": "f1"
}
