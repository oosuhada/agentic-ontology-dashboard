# Application
APP_ENV=development
APP_HOST=127.0.0.1
API_PORT=8100
WEB_PORT=3100
ONTOLOGY_DASHBOARD_DB=./data/local/ontology_dashboard.db
# Comma-separated absolute origins. Production accepts HTTPS origins only.
ONTOLOGY_DASHBOARD_ALLOWED_ORIGINS=
# Optional bounded regex for preview hosts, e.g. ^https://.*\.vercel\.app$
ONTOLOGY_DASHBOARD_ALLOWED_ORIGIN_REGEX=
# Production normally requires PostgreSQL through ONTOLOGY_DASHBOARD_DATABASE_URL.
ONTOLOGY_DASHBOARD_DATABASE_URL=
ONTOLOGY_DASHBOARD_ALLOW_PRODUCTION_SQLITE=0
# Team DB helper. Never put the password in this file.
ONTOLOGY_DASHBOARD_TEAM_DB_HOST=gabriels-m1-mac-mini.tailb988c5.ts.net
ONTOLOGY_DASHBOARD_TEAM_DB_PORT=15432
ONTOLOGY_DASHBOARD_TEAM_DB_NAME=ontology_dashboard
ONTOLOGY_DASHBOARD_TEAM_DB_USER=ontology_team_readonly
ONTOLOGY_DASHBOARD_TEAM_ORGANIZATION_ID=org-ontology-demo
ONTOLOGY_DASHBOARD_TEAM_PROJECT_ID=manufacturing-demo-project
ONTOLOGY_DASHBOARD_TEAM_WORKSPACE_ID=manufacturing-demo
# Deprecated compatibility key. Leave unset in new environments.
# FACTORY_SIGNAL_DB=./data/local/factory_signal_board.db
VITE_API_BASE_URL=http://127.0.0.1:8100
VITE_WEEK2_Operations_ONLY=true
VITE_FEATURE_ONTOLOGY_WORKBENCH=true
VITE_FEATURE_DATASET_CATALOG=false
VITE_FEATURE_GOVERNANCE_WORKBENCH=true
OPEN_BROWSER=1

# Development/demo identity bootstrap. Demo accounts are always forbidden when
# APP_ENV=production, even if this flag is accidentally enabled.
SEED_DEMO_ACCOUNTS=1
ENABLE_PUBLIC_BLUEPRINT_COMPARISON=0

# Model and policy
# Versioned Model Artifact provider URI. Backend must not depend on a sibling
# generator directory. local/demo/test may use the heuristic fallback by default;
# development/dev/deploy/staging/production should provide a Model Artifact.
MODEL_ARTIFACT_URI=
# Explicit override. Keep disabled in development/deploy/production unless a
# fallback is intentionally accepted for a specific run.
ONTOLOGY_DASHBOARD_ALLOW_HEURISTIC_MODEL_FALLBACK=0
TRAINED_MODEL_POLICY_PATH=./ml/config/trained_model_policy.json
THRESHOLD_POLICY_PATH=./ml/config/threshold_policy.json
REPORT_MODE=deterministic

# Optional OpenAI-compatible LLM provider.
# With empty credentials, reports and layouts use deterministic fallback.
LLM_PROVIDER=deterministic
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
OPENAI_API_KEY=

# Vertex AI (recommended): authenticate with ADC or a service account. Do not put a
# Enterprise identity. Secrets stay in the deployment secret manager; the app
# receives only a reference that the production adapter resolves.
ONTOLOGY_DASHBOARD_OIDC_ISSUER=
ONTOLOGY_DASHBOARD_OIDC_CLIENT_ID=
ONTOLOGY_DASHBOARD_OIDC_AUDIENCE=
ONTOLOGY_DASHBOARD_OIDC_CLIENT_SECRET_REF=
ONTOLOGY_DASHBOARD_OIDC_CALLBACK_ALLOWLIST=https://dashboard.example.com/api/auth/oidc/callback
# Vertex credential JSON or a Google API key in this file.
# LLM_PROVIDER=vertex-ai
# LLM_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# Optional provider-specific keys retained for future adapters
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Project 3 graph/RAG service boundary. The mapping may be JSON or
# comma-separated Project2=Project3 pairs.
ONTOLOGY_DASHBOARD_PROJECT3_URL=http://127.0.0.1:8001
ONTOLOGY_DASHBOARD_PROJECT3_PROJECT_MAP={"manufacturing-demo-project":"cip-dmd"}
ONTOLOGY_DASHBOARD_PROJECT3_TIMEOUT_SECONDS=4
ONTOLOGY_DASHBOARD_PROJECT3_MAX_RETRIES=1
ONTOLOGY_DASHBOARD_PROJECT3_CIRCUIT_FAILURES=3
ONTOLOGY_DASHBOARD_PROJECT3_CIRCUIT_RESET_SECONDS=30

# Historical maintenance-context adapter retained during migration.
MAINTENANCE_CONTEXT_PROVIDER=fixture
PROJECT3_API_URL=

# Maintenance transactional outbox -> gen_data Runtime Overlay inbox.
# The dispatcher is an explicit worker process:
#   python -m app.maintenance_replay_dispatcher --drain
# Both repositories must point at the same mounted JSONL file for the local/Mac
# mini adapter. Production may replace only this transport adapter.
ONTOLOGY_DASHBOARD_OUTBOX_ORGANIZATION_ID=
ONTOLOGY_DASHBOARD_OUTBOX_PROJECT_ID=
ONTOLOGY_DASHBOARD_MAINTENANCE_REPLAY_EVENT_FILE=
ONTOLOGY_DASHBOARD_OUTBOX_MAX_ATTEMPTS=5
ONTOLOGY_DASHBOARD_OUTBOX_RETRY_SECONDS=5
ONTOLOGY_DASHBOARD_OUTBOX_LEASE_SECONDS=60

# Polyglot local profile. Start PostgreSQL+pgvector, Neo4j and bootstrap with:
# docker compose -f infra/docker-compose.yml --profile polyglot up -d postgres neo4j migration-bootstrap
# Build the API with API_EXTRAS=polyglot when ONTOLOGY_DASHBOARD_DATABASE_URL is enabled.
API_EXTRAS=
POSTGRES_DB=ontology_dashboard
POSTGRES_USER=ontology
POSTGRES_PASSWORD=ontology-local-only
POSTGRES_PORT=5432
ONTOLOGY_DASHBOARD_SEED_REFERENCE_DATA=true
ONTOLOGY_DASHBOARD_VECTOR_DIMENSIONS=1536
ONTOLOGY_DASHBOARD_NEO4J_URI=bolt://127.0.0.1:7687
ONTOLOGY_DASHBOARD_NEO4J_DATABASE=neo4j
ONTOLOGY_DASHBOARD_NEO4J_USERNAME=neo4j
ONTOLOGY_DASHBOARD_NEO4J_PASSWORD=ontology-local-only
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ontology-local-only
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Optional Redis cache/checkpoint/rate-limit profile:
# docker compose -f infra/docker-compose.yml --profile cache up -d redis
REDIS_PASSWORD=ontology-local-only
REDIS_PORT=6379
ONTOLOGY_DASHBOARD_REDIS_URL=
ONTOLOGY_DASHBOARD_REDIS_TLS_REQUIRED=1
ONTOLOGY_DASHBOARD_REDIS_POOL_MAX=20
ONTOLOGY_DASHBOARD_MAX_QUEUED_JOBS_PER_PROJECT=5000
ONTOLOGY_DASHBOARD_JOB_LEASE_SECONDS=60
ONTOLOGY_DASHBOARD_WORKER_JOB_TYPES=analysis
ONTOLOGY_DASHBOARD_WORKER_POLL_SECONDS=1

# Governed object storage. Production must use a durable provider and secret
# references; local is an emulator for development/test only.
ONTOLOGY_DASHBOARD_OBJECT_STORAGE_BACKEND=local
ONTOLOGY_DASHBOARD_OBJECT_STORAGE_LOCAL_ROOT=.runtime/object-storage
ONTOLOGY_DASHBOARD_OBJECT_STORAGE_BUCKET=
ONTOLOGY_DASHBOARD_OBJECT_STORAGE_ENDPOINT=
ONTOLOGY_DASHBOARD_OBJECT_STORAGE_REGION=
ONTOLOGY_DASHBOARD_OBJECT_STORAGE_CREDENTIAL_REF=
ONTOLOGY_DASHBOARD_OBJECT_STORAGE_SSE=AES256
ONTOLOGY_DASHBOARD_ARTIFACT_SIGNING_SECRET_REF=
ONTOLOGY_DASHBOARD_ARTIFACT_SIGNING_SECRET=
ONTOLOGY_DASHBOARD_ARTIFACT_SYSTEM_ACTOR_ID=user-admin

# Observability. OTLP and alert destinations are external capabilities; local
# structured logs and Prometheus exposition work without a collector.
ONTOLOGY_DASHBOARD_LOG_LEVEL=INFO
ONTOLOGY_DASHBOARD_LOG_HASH_SALT=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
ONTOLOGY_DASHBOARD_METRICS_TOKEN=
ONTOLOGY_DASHBOARD_ALERT_DESTINATION_REF=

# Generator Runtime Prediction Pipeline
GENERATOR_RUNTIME_VERSION=1.0.0
GENERATOR_PIPELINE_INPUT_ROOTS=./data,./data_preprocessed,./contracts
GENERATOR_PIPELINE_QUEUE_DB=./data_preprocessed/pipeline_queue/queue.db
GENERATOR_NOTIFICATION_OUTBOX_ROOT=./data_preprocessed/prediction_outbox
GENERATOR_PIPELINE_MAX_ATTEMPTS=5
GENERATOR_PIPELINE_RETRY_BACKOFF_SECONDS=1.0
GENERATOR_PREDICTION_RESULT_URL=http://localhost:8000/internal/prediction-results

# Generator Protocol Extraction Pipeline
GEN_DATA_OUTPUT_DIR=
GENERATOR_OBSERVATIONS_ROOT=./data/observations
GENERATOR_EXTRACTION_RUNS_ROOT=./data_preprocessed/extraction_runs
GENERATOR_EXTRACTION_STATE_ROOT=./data_preprocessed/extraction_state
GENERATOR_MAPPING_ROOT=./ontology/mappings
GENERATOR_EXTRACTION_INPUT_ROOTS=./data,./data_preprocessed,./contracts,./output
GENERATOR_EXTRACTION_BATCH_SIZE=1000
GENERATOR_EXTRACTION_LOCK_LEASE_SECONDS=300
EXTRACTION_ENABLED=true
EXTRACTION_INTERVAL_SECONDS=10
EXTRACTION_WORKER_ENABLED=false
EXTRACTION_RUNTIME_HANDOFF_ENABLED=true
EXTRACTION_RUNTIME_HANDOFF_INTERVAL_SECONDS=10
GENERATOR_RUNTIME_PREDICTION_ENABLED=true
