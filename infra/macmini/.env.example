# Host paths / local ports
ONTOLOGY_DATA_ROOT=/Users/your-user/services/ontology-dashboard-data
BACKEND_PORT=8110
FRONTEND_PORT=8120
GEN_DATA_REPO_ROOT=/Users/your-user/services/ontology-dashboard-data/gen_data
GEN_DATA_RUNTIME_ROOT=/Users/your-user/services/ontology-dashboard-data/gen_data-runtime-wall-clock-v2
GEN_DATA_RUNTIME_OUTPUT_ROOT=/Users/your-user/services/ontology-dashboard-data/gen_data-runtime-wall-clock-v2/output
RUNTIME_PIPELINE_INPUT_ROOT=/Users/your-user/services/ontology-dashboard-data/runtime-pipeline-input
ONTOLOGY_DASHBOARD_GENERATOR_RUNTIME_ENQUEUE_URL=
PREDICTION_RESULT_INGEST_TOKEN=
GENERATOR_RUNTIME_VERSION=hanbit-generator-runtime-v1
GEN_DATA_LIVE_INTERVAL_MINUTES=10
GEN_DATA_CLOCK_MODE=wall_clock
GEN_DATA_LIVE_SEED=42
GEN_DATA_PYTHON=/opt/homebrew/bin/python3
LIVE_PM_POLL_SECONDS=5

# PostgreSQL. Real credentials live only in the Mac mini .env (chmod 600).
POSTGRES_DB=ontology_dashboard
POSTGRES_USER=ontology
POSTGRES_PASSWORD=
ONTOLOGY_DASHBOARD_DATABASE_URL=postgresql://ontology:CHANGE_ME@postgres:5432/ontology_dashboard

# Frontend origins. Keep this narrow; do not use '*'.
ONTOLOGY_DASHBOARD_ALLOWED_ORIGINS=https://biz-collabcraft-ontology-dashboard.vercel.app
ONTOLOGY_DASHBOARD_ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Model Artifact boundary. Backend reads; Generator publishes.
BACKEND_MODEL_ARTIFACT_URI=/artifacts/compressor-failure-risk/current
BACKEND_CNC_MODEL_ARTIFACT_URI=/artifacts/cnc-failure-risk/current
GENERATOR_TRAINING_N_JOBS=2
OPENAI_API_KEY=
GENERATOR_LLM_PROVIDER=vertex_ai
GENERATOR_LLM_MODEL=gemini-3.7-flash
VERTEX_AI_API_KEY=
GOOGLE_CLOUD_PROJECT=flai-oosuhada-20260506
GOOGLE_CLOUD_LOCATION=global
GENERATOR_GOOGLE_APPLICATION_CREDENTIALS_HOST=/Users/your-user/services/ontology-dashboard-data/secrets/vertex/vertex-runtime.json

# Backend LLM variables are independent from Generator OPENAI_API_KEY.
LLM_PROVIDER=deterministic
LLM_MODEL=
LLM_API_KEY=
MAINTENANCE_CONTEXT_PROVIDER=fixture
SEED_DEMO_ACCOUNTS=0
ONTOLOGY_DASHBOARD_SEED_REFERENCE_DATA=false
ONTOLOGY_DASHBOARD_ALLOW_HEURISTIC_MODEL_FALLBACK=0
