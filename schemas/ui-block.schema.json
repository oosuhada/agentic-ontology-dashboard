{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-dashboard.local/schemas/ui-block.schema.json",
  "title": "Governed UI Block Layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "layout_id", "event_id", "role", "intent", "mode", "blocks", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "layout_id": {"type": "string"},
    "event_id": {"type": "string"},
    "role": {"enum": ["manager", "engineer"]},
    "intent": {"enum": ["overview", "explain-risk", "compare", "summarize-manager", "detail-engineer", "recommend-check", "show-model-details"]},
    "mode": {"enum": ["deterministic", "llm", "deterministic_fallback"]},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "type", "title", "order", "emphasis", "data_fields", "collapsed"],
        "properties": {
          "block_id": {"type": "string"},
          "type": {"enum": ["StatusSummary", "RiskKpi", "PriorityList", "ImpactSummary", "ManagerDecisionCard", "SensorLineChart", "AnomalyTimeline", "FactorContribution", "EvidenceTable", "RecommendedActions", "EngineerChecklist", "DataQualityWarning", "ModelDetails", "ConversationThread"]},
          "title": {"type": "string"},
          "order": {"type": "integer", "minimum": 1},
          "emphasis": {"enum": ["primary", "secondary", "detail"]},
          "data_fields": {"type": "array", "items": {"type": "string"}},
          "collapsed": {"type": "boolean"}
        }
      }
    },
    "generated_at": {"type": "string"}
  }
}
